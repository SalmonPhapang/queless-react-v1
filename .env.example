# ── Feature flags ─────────────────────────────────────────────────────────────
# SMS OTP verification on login, signup and profile phone changes.
# Leave off until the SMS provider is configured.
EXPO_PUBLIC_PHONE_OTP_ENABLED=false

# Ask for notification permission after the location prompt. Order status
# pushes are core behaviour; only set this to false for an intentionally
# notification-free build.
EXPO_PUBLIC_NOTIFICATIONS_ENABLED=true

# Client-side environment. Vercel Production uses "prod" (R50/R90 minimums);
# Preview and local development use "dev" (R10 minimums).
EXPO_PUBLIC_APP_ENV=dev

# Public Supabase config. EAS builds must also define these as plaintext project
# environment variables because .env files are not included in build archives.
EXPO_PUBLIC_SUPABASE_URL=https://lxsvydiyzeavdqbjxkpp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Tracking map ─────────────────────────────────────────────────────────────
# "osm"    = Leaflet + raster tiles in a WebView (default: keyless OSM tiles)
# "google" = react-native-maps (needs a Google Maps API key in the native build)
EXPO_PUBLIC_MAPS_PROVIDER=osm

# Optional: override tracking map tiles via .env (build-time, client-side).
# Defaults to keyless OpenStreetMap tiles. CARTO basemaps require an API key
# (https://carto.com/basemaps/apikey) — include it in the tile URL if used.
# Supabase Edge Function secrets are not available to the app/WebView.
# EXPO_PUBLIC_MAP_TILES_LIGHT=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_TILES_DARK=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# ── Expo CLI ──────────────────────────────────────────────────────────────────
# Set automatically by the npm scripts to skip Expo's API response cache.
# This avoids a Node 26 cache corruption crash during dependency validation.
EXPO_NO_CACHE=1

# ── Delivery-radius testing ────────────────────────────────────────────────────
# Dev-only: force every store to appear this far away so you can test browsing
# without ordering. Ignored in production exports.
# EXPO_PUBLIC_TEST_DELIVERY_DISTANCE_KM=25

# ── Web debugging ─────────────────────────────────────────────────────────────
# Run `npm run web` to open the app in a browser. The tracking map uses the
# Leaflet/OSM iframe on web even if EXPO_PUBLIC_MAPS_PROVIDER=google.
# Paystack checkout is native-only; the web screen offers a manual verify button.

# ---- Cross-platform notifications -----------------------------------------
# Native push uses Expo tokens from expo-notifications. Browser push uses a
# standard PushSubscription; this is the VAPID PUBLIC key and is safe to ship.
# The matching PRIVATE key belongs only in the Supabase Edge Function secret
# WEB_PUSH_PRIVATE_KEY. Never add it to an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_WEB_PUSH_ENABLED=true
EXPO_PUBLIC_WEB_PUSH_PUBLIC_KEY=BKzWSW-uiaeClLGMck7ptVrWnIP07zMKUuoICw-G7KRppgH59StYPCfUfcpzosF5Lelhu1spJWT6scMpbl203nw

# Expo project id used to mint native push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=07669b65-51e8-4c55-abcb-931ee561451a
